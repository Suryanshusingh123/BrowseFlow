# AI Provider - choose one or both
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Which AI provider to use: "gemini" or "openai"
AI_PROVIDER=gemini

# Browser settings
BROWSER_HEADLESS=false      # Set to true in production/CI
BROWSER_SLOW_MO=0           # Add milliseconds to slow down for debugging

# App settings
DEBUG=true
